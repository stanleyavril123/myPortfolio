# Copy this to /tmp/sms-demo.env and fill it in locally.
# Do not paste credentials into chat or commit the filled file.
# The live demo will send SMS to DEMO_CUSTOMER_PHONE and create a test event.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_CALENDAR_TIMEZONE=America/Toronto

OPENAI_API_KEY=
OPENAI_MODEL=
LLM_ENABLED=true
LLM_PROVIDER=openai

# Your own phone number, in international format (for example +1514...).
DEMO_CUSTOMER_PHONE=

# A future appointment time with a timezone offset, on the calendar above.
# Example format: 2026-10-20T15:00:00-04:00
DEMO_APPOINTMENT_START=

# Sample service and address for the test. Use fictional demo details.
DEMO_SERVICE=
DEMO_ADDRESS=
